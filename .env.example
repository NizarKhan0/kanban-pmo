APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Kanban PMO
PMO_TIMEZONE=Asia/Kuala_Lumpur
PMO_PIC_OVERLOAD_THRESHOLD=5

# Module 05 — Scheduled automation
PMO_STANDUP_TIME=08:30
PMO_OVERDUE_CHECK_TIME=09:00

# Module 05 — AI PMO Assistant (leave PMO_AI_API_KEY empty for free Smart Simulation mode)
PMO_AI_PROVIDER=claude
PMO_AI_MODEL=claude-sonnet-5-5
PMO_AI_API_KEY=
PMO_AI_CUSTOM_ENDPOINT=
PMO_AI_EFFORT=medium

# Module 05 — Telegram Bot
PMO_TELEGRAM_ENABLED=false
PMO_TELEGRAM_BOT_TOKEN=
PMO_TELEGRAM_CHAT_ID=

# Module 05 — Gmail / Email (uses the MAIL_* settings above, e.g. MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com)
PMO_EMAIL_ENABLED=false
PMO_EMAIL_RECIPIENT=

# Module 05 — WhatsApp Gateway (without a gateway, wa.me quick links are used)
PMO_WHATSAPP_ENABLED=false
PMO_WHATSAPP_GATEWAY_URL=
PMO_WHATSAPP_API_TOKEN=
PMO_WHATSAPP_DEFAULT_PHONE=
